# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Anthropic API key for recipe import and meal suggestions (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model (defaults to claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5

# Time zone used for "today" and the weekly plan
NEXT_PUBLIC_TIMEZONE=America/Toronto
